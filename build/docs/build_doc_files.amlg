(seq
	(declare {
		convert_group_name (lambda
			(declare {opcode_group ""}
				(apply "concat"
					(map (lambda
							(if (or
								(<= "A" (current_value) "Z")
								)
								(format (+ (format (current_value) "int8" "number") 32) "number" "int8")
								
								(= (current_value) " ")
								"_"
								
								(current_value)
							)
						)
						(explode opcode_group)
					)
				)
			)
		
		)

		;names for opcodes that consist of symbols, since symbols are stripped from markdown heading ids
		;any opcode not listed here uses its own name as the anchor
		symbolic_opcode_names (assoc
			"+" "add"
			"-" "subtract"
			"*" "multiply"
			"/" "divide"
			"=" "equal"
			"!=" "not_equal"
			"<" "less_than"
			"<=" "less_than_or_equal"
			">" "greater_than"
			">=" "greater_than_or_equal"
			"~" "type_equal"
			"!~" "type_not_equal"
		)

		;returns the string used in the markdown heading id and link anchor for the opcode
		convert_opcode_anchor (lambda
			(declare {opcode ""}
				(if (contains_index symbolic_opcode_names opcode)
					(get symbolic_opcode_names opcode)
					opcode
				)
			)
		)
		
		current_opcode_group ""

		;maps each opcode group to its position in the opcodes list, used to order the site navigation
		opcode_group_nav_order (assoc)
    })

	
	(store "./index.md" (concat
		(help "overview") "\n"
	))

	(store "./syntax.md" (concat
		(help "syntax") "\n"
	))

	(store "./distance_and_surprisal.md" (concat
		(help "distance") "\n"
	))

	(store "./idioms.md" (concat
		(help "idioms") "\n"
	))

	(assign "current_opcode_group" "")

	(store "./opcodes.md" (concat
		"## Opcodes\n"
		(apply "concat"
			(map
				(lambda
					(let {
							opcode (current_value 1)
							details (help (current_value 1))
						}

						(let
							{result_string ""}

							(if (!= current_opcode_group (get details "opcode_group"))
								(seq
									(assign "opcode_group_nav_order" (get details "opcode_group") (+ 1 (size opcode_group_nav_order)))
									(assign {
										current_opcode_group (get details "opcode_group")
										result_string (concat "### " (get details "opcode_group") "\n")
										})
								)
							)

							(concat
								result_string
								"  - ["
								;escape so markdown does not treat it as emphasis
								(if (= opcode "*") "\\*" opcode)
								"](./"
								(call convert_group_name {opcode_group (get details "opcode_group")})
								".md#opcode-" (call convert_opcode_anchor {opcode opcode}) ")"
								"\n")
						)
					)
				)
				(help "opcodes")
			)
		)
	))

	(let {
			opcode_groups_docs
			(zip
				(lambda 
					(concat (current_value 1) (current_value))
				)
				(map (lambda
						(get (help (current_value)) "opcode_group")
					)
					(help "opcodes")
				)
				(map
					(lambda
						(let {
								opcode (current_value 1)
								details (help (current_value 1))
							}

						(let {
								anchor (call convert_opcode_anchor {opcode opcode})
							}
							
							(concat
								"### Opcode: `" opcode "`"
								;explicitly set the heading id when it would not be derived from the opcode name
								(if (!= anchor opcode) (concat " {#opcode-" anchor "}") "")
								"\n"
								"#### Parameters\n"
								"`" (get details "parameters") "`\n"
								"#### Returns\n"
								"`" (get details "returns") "`\n"
								"#### Description\n"
								(get details "description") "\n"
								"#### Details\n"
								" - Permissions required:  " (get details "permissions") "\n"
								" - Allows concurrency: " (if (get details "allows_concurrency") "true" "false") "\n"
								" - Requires entity: " (if (get details "requires_entity") "true" "false") "\n"
								" - Creates new scope: " (if (get details "new_scope") "true" "false") "\n"
								" - Creates new target scope: " (if (get details "new_target_scope") "true" "false") "\n"
								" - Value newness (whether references existing node): " (get details "value_newness") "\n"
								"#### Examples\n"
								(apply "concat"
									(map
										(lambda
											(concat
												"Example:\n```amalgam\n"
												(get (current_value) "example")
												"\n```\nOutput:\n```amalgam\n"
												(get (current_value) "output")
												"\n```\n"
											)
										)
										(get details "examples")
									)
								)

								"\n"
								"[Amalgam Opcodes](./opcodes.md)\n\n"
							)
						)
						)
					)
					(help "opcodes")
				)
			)
		}
		
		(map
			(lambda
				(let {
						opcode_group_name (current_index 1)
						opcode_group
							(call convert_group_name {opcode_group (current_index 2)})
						opcode_text (current_value 1)
					}
					(print "writing to " opcode_group "\n")
					(store (concat opcode_group ".md") (concat
						;front matter for the documentation site, ordered the same as the opcodes list
						"---\n"
						"layout: default\n"
						"title: " opcode_group_name "\n"
						"parent: Opcodes\n"
						"nav_order: " (get opcode_group_nav_order opcode_group_name) "\n"
						"---\n\n"
						opcode_text
					))
				)
			)
			opcode_groups_docs
		)
	)
 )
