; Outer Interpreter graphs and serial nested operations publish all child results.
; Allocating retained nested lists also exercises concurrent garbage collection.
(print
 (and
  (= (apply "+" ||(map
       (lambda (apply "+" ||(map
         (lambda (apply "+" ||(range (lambda (+ (current_index) 1)) 0 15 1)))
         (range 0 7))))
       (range 0 7)))
     8704)
  (= ||(filter (lambda (> (current_value) 5)) (range 0 9)) [6 7 8 9])
  (= ||(associate "a" ||(+ 1 2) "b" ||(+ 3 4)) {a 3 b 7})
  (= ||[||(+ 1 2) ||(+ 3 4)] [3 7])
  (= ||{a ||(+ 1 2) b ||(+ 3 4)} {a 3 b 7})
  (= (let {x []}
       ||(map (lambda (accum "x" [] (current_value))) (range 1 1000))
       (size x))
     1000)
  ; move_entities holds the source write reference while evaluating destination.
  (= (seq
       (create_entities "move_a" (lambda 1))
       (create_entities "move_b" (lambda 1))
       ||[(move_entities "move_a" ||(concat "moved" "_a"))
          (move_entities "move_b" ||(concat "moved" "_b"))]
       (sort (contained_entities)))
     ["moved_a" "moved_b"])
  (= (get ||(map
        (lambda ||(map (lambda (range 0 99)) (range 0 15)))
        (range 0 31))
       [0 0 0] [31 15 99])
     [0 99])
 ))
