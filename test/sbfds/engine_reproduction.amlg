; Optional integration reproduction. Pass the Howso Engine source directory
; (with a trailing slash) as argv[1]. Engine files are only loaded, never stored.
(seq
	(system "set_max_num_threads" 4)
	(declare (assoc
		engine_root (get argv 1)
		checks 0 failures 0
		check_engine (lambda (seq
			(destroy_entities "howso")
			(load_entity (concat engine_root "howso.amlg") "howso")
			(call_entity "howso" "initialize" (assoc trainee_id "sbfds" filepath engine_root))
			(if attributes (call_entity "howso" "set_feature_attributes" (assoc feature_attributes attributes)))
			(call_entity "howso" "train" (assoc features ["x" "y"] session "s" cases cases))
			(call_entity "howso" "set_params" (assoc default_data_parameters_map parameters))
			(declare (assoc case_indices (map (lambda (list "s" (current_value 1))) (range 0 (- (size cases) 1)))))
			(declare (assoc
				nearest_response (call_entity "howso" "get_distances"
					(assoc features ["x" "y"] case_indices case_indices sparse .true num_nearest_neighbors k row_count 1))
				all_response (call_entity "howso" "get_distances"
					(assoc features ["x" "y"] case_indices case_indices sparse .true num_nearest_neighbors (size cases) row_count 1))
			))
			(declare (assoc
				nearest (get nearest_response [1 "payload" "distances" 0])
				all (get all_response [1 "payload" "distances" 0])
				nearest_ids (get nearest_response [1 "payload" "column_numeric_indices" 0])
				all_ids (get all_response [1 "payload" "column_numeric_indices" 0])
			))
			(declare (assoc all_by_id (zip all_ids all)))
			(accum (assoc checks 1))
			(if (not (and
				(= (size nearest) k)
				(= (size all) (- (size cases) 1))
				(<= (apply "max" (map (lambda (abs (- (first (current_value)) (last (current_value)))))
					nearest (trunc all k))) 1e-9)
				(<= (apply "max" (map (lambda (abs (- (get all_by_id (first (current_value))) (last (current_value)))))
					nearest_ids nearest)) 1e-9)
			))
				(seq
					(accum (assoc failures 1))
					(print "FAIL Engine " name " nearest=" (unparse nearest_response) " all=" (unparse all_response) "\n")
				)
				(print "PASS Engine " name " nearest=" (unparse nearest) " ids=" (unparse nearest_ids) "\n")
			)
		))
	))
	(call check_engine (assoc name "A1 string" k 1
		cases [["a" 0] ["a" 0] ["b" 0.1] ["c" 0.2] ["d" 0.3]]
		attributes {x {type "nominal" data_type "string"}}
		parameters {k 2 p 1 dt -1 featureDeviations {x [{a [{a 0.4 b 0.4 c 0.8} 0.9]} 0.9 0.9] y [0 20 20]}}))
	(call check_engine (assoc name "A1 number" k 1
		cases [[1 0] [1 0] [2 0.1] [3 0.2] [4 0.3]]
		attributes {x {type "nominal" data_type "number"}}
		parameters {k 2 p 1 dt -1 featureDeviations {x [{1 [{1 0.4 2 0.4 3 0.8} 0.9]} 0.9 0.9] y [0 20 20]}}))
	(call check_engine (assoc name "A2 bool SDM" k 2
		cases [[.true 0] [.true 0.2] [.false 0.35] [.null 0.3]]
		attributes {x {type "nominal" data_type "boolean"}}
		parameters {k 2 p 1 dt -1 featureDeviations {x [{.true [{.true 0.1 .false 0.8} 0.9]} 0.9 0.9] y [0 20 20]}}))
	(call check_engine (assoc name "A3 weighted null" k 2
		cases [[0 0] [10 0] [20 0.1] [30 0.2] [40 0.3] [50 0.4] [.null 0.5]]
		attributes .null
		parameters {k 2 p 1 dt -1 featureWeights {x 0.01 y 0.1} featureDeviations {x [0 2 2] y [0 10 10]}}))
	(map (lambda
		(call check_engine (assoc name (concat "A4 surprisal p=" (current_value 1)) k 2
			cases [[0 0] [0 4] [3 3] [4 0] [0 5] [5 0]] attributes .null
			parameters (assoc k 2 p (current_value 2) dt "surprisal_to_prob" featureDeviations {x [1 9 9] y [1 9 9]}))))
		[0.5 1 2])
	(print "Engine checks=" checks " failures=" failures "\n")
)
